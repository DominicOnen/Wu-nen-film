# Copy these into Render → your service → Environment.
# Never commit a real .env file with actual secrets to Git.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # Project Settings → API → service_role (secret!)
ALLOWED_ORIGIN=https://your-site.pages.dev         # Your Cloudflare Pages URL, or * while testing
PORT=3000

# Optional — only needed if you enable email sending in routes/booking.js
RESEND_API_KEY=your-resend-api-key
